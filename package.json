{
  "name": "@local/dsh-composer-drawer",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Collapse the message composer for focused reading and restore it with a drag or click.",
  "author": "gaoerge",
  "license": "MIT",
  "homepage": "https://github.com/gaoerge/dsh-composer-drawer#readme",
  "repository": { "type": "git", "url": "git+https://github.com/gaoerge/dsh-composer-drawer.git" },
  "bugs": { "url": "https://github.com/gaoerge/dsh-composer-drawer/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "composer"],
  "icon": "./icon.svg",
  "engines": { "dsh": "0.2.1-rc.5" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/en.json", "locale/zh.json", "icon.svg", "README.md", "README.en.md", "LICENSE", "CHANGELOG.md", "scripts/verify.mjs", "docs/images/"],
  "scripts": { "check": "node --check index.js && node --check client.js && node --check scripts/verify.mjs && node scripts/verify.mjs --readme-links" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation"] } }
}
